rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.admin == true;
    }

    match /news_posts/{docId} {
      allow read: if true;
      allow create, delete: if isAdmin();

      // Admin edits cannot alter views.
      allow update: if isAdmin()
        && request.resource.data.views == resource.data.views;

      // Public can increment views by exactly one and cannot change any other field.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
        && request.resource.data.views == resource.data.views + 1;
    }

    match /job_alerts/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /citizen_reports/{docId} {
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'location', 'details', 'date', 'phone', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.location is string
        && request.resource.data.location.size() <= 200
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 5000;

      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
